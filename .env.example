# Copy this file to .env and fill in your values. .env is listed in
# .gitignore and must never be committed. Variables already set in your
# environment take precedence over this file.

# --- Outgoing mail (the nightly digest) -----------------------------------
# For Gmail, create an app password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Paste it without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
# Where the digest is sent. Defaults to SMTP_USER when left empty.
MAIL_TO=you@example.com

# --- Incoming mail (optional, only for the indeed_email board) ------------
# Leave IMAP_USER and IMAP_PASS empty to reuse the SMTP values.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX='"[Gmail]/All Mail"'
INDEED_LOOKBACK_DAYS=3

# --- Behavior ---------------------------------------------------------------
# "daily" (default), a weekday number 0=Monday..6=Sunday, or "never".
# Controls when a "nothing new today" status email is sent.
HEARTBEAT_DAY=daily
# Screening profile module. Leave empty to use screening_local.py when it
# exists, otherwise screening_example.py.
JOB_MONITOR_PROFILE=
